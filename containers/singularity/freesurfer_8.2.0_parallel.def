Bootstrap: docker
From: freesurfer/freesurfer:8.2.0

%labels
    Maintainer Tsubasa Hirakawa <hirakawa@mprg.cs.chubu.ac.jp>
    Description FreeSurfer 8.2.0 with GNU Parallel

%post
    # --------------------------------------------------
    # Enable EPEL and PowerTools repositories
    # --------------------------------------------------
    dnf install -y dnf-plugins-core epel-release
    dnf config-manager --set-enabled powertools

    # --------------------------------------------------
    # Install GNU Parallel
    # --------------------------------------------------
    # hostname: recon-all が IsRunning.* の HOST に書く (ベースイメージに無い)
    dnf install -y parallel hostname
    dnf clean all
    rm -rf /var/cache/dnf

    # Verify installation
    parallel --version

    # --------------------------------------------------
    # 実行時の bind 先 (scripts/singularity/ のジョブが使う)。
    # underlay が無効なクラスタでも bind できるよう、ディレクトリを作っておく。
    # --------------------------------------------------
    mkdir -p /input /output /fs_license /run_dir

%test
    parallel --version
    command -v recon-all
